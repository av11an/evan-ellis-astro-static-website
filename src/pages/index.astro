---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello!</h1>
			<p>
				Welcome to my personal website where I get a chance to share
				a little bit about myself.
			</p>
			<p>
				I am currently a Software Development Engineer at AWS. I
				specifically work on Life Science related products.
				I live in Washington, love to play Tennis in the Spring/Summer and then play Hockey in 
				the Fall/Winter. I also ride motorcycles! Below
				is a picture of my new Ninja ZX-6R.
			</p>
            <img src="/images/motorcycles/zx6r/first-ride.jpg" alt="ZX-6R"/>
			<p>
				Be sure to check out my blog where I talk about topics I am
				interested in or about projects I am currently working on.
                And the moto section where I write about the bikes that I own or have owned.
            </p>
		</main>
		<Footer />
	</body>
</html>
